# GridDB Cloud values from the Azure Marketplace service dashboard.
GRIDDB_NOTIFICATION_PROVIDER='https://example.invalid/provider?token=replace-me'
GRIDDB_CLUSTER_NAME='your-cluster'
GRIDDB_DATABASE='your-database'
GRIDDB_USERNAME='your-user'
GRIDDB_PASSWORD='your-password'

# PUBLIC connects through the GridDB Cloud 3.2 public native route.
# Leave empty when using the private route through VNet peering.
GRIDDB_CONNECTION_ROUTE='PUBLIC'
GRIDDB_SSL_MODE='PREFERRED'

# Example query used by npm start.
GRIDDB_CONTAINER='example'
GRIDDB_TQL='SELECT * LIMIT 10'

# Containers used by npm run init, npm run seed, and the live dashboard.
GRIDDB_DEVICE_IDS='ac_office_01,cold_room_02,water_pump_01'

# Local-only Node adapter read by the browser dashboard.
GRIDDB_API_HOST='127.0.0.1'
GRIDDB_API_PORT='3001'

# Optional overrides.
PYTHON_BIN='./.venv/bin/python'
GRIDDB_REQUEST_TIMEOUT_MS='30000'
