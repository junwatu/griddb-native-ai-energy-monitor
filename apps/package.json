{
  "name": "griddb-energy-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace commands for the GridDB Energy AI applications",
  "workspaces": [
    "dashboard",
    "native-bridge"
  ],
  "scripts": {
    "setup": "npm install",
    "setup:mac": "npm run setup:mac --workspace=native-bridge",
    "setup:linux": "node scripts/platform-setup.mjs linux",
    "setup:windows": "node scripts/platform-setup.mjs windows",
    "init": "node scripts/init-griddb.mjs",
    "seed": "node scripts/seed-griddb.mjs",
    "forecast": "node scripts/forecast-griddb.mjs",
    "dev": "npm run dev --workspace=dashboard",
    "api": "node scripts/start-api.mjs",
    "dev:live": "node scripts/dev-live.mjs",
    "dev:griddb": "node scripts/dev-griddb.mjs",
    "build": "npm run build --workspace=dashboard",
    "check": "node scripts/workspace-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "npm run seed && npm run forecast && npm run dev:live"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
