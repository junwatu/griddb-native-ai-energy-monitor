  "cards": [
    {
      "dot": "emerald",
      "title": "Persistent local bridge",
      "items": [
        "Node.js starts one Python worker and reuses it",
        "NDJSON travels only over child-process stdin/stdout",
        "Request IDs match replies to pending Promises"
      ]
    },
    {
      "dot": "rose",
      "title": "Native database connection",
      "items": [
        "JPype invokes the GridDB Java client inside the local JVM",
        "The Java client connects to GridDB Cloud using native TLS/TCP",
        "No HTTPS request and no GridDB Web API are used"
      ]
    },
    {
      "dot": "amber",
      "title": "Lazy Cloud session",
      "items": [
        "get_store creates a handle before network I/O",
        "The first get, query, or put establishes the Cloud session",
        "PUBLIC is used for the allowed public connection route"
      ]
    }
  ]
