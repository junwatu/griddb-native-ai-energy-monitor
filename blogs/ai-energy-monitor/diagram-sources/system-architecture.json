      "label": "energy readings",
      "variant": "emphasis"
    },
    {
      "id": "node-to-python",
      "from": "node-app",
      "to": "python-worker",
      "label": "NDJSON over stdio",
      "variant": "emphasis"
    },
    {
      "id": "python-to-java",
      "from": "python-worker",
      "to": "java-client",
      "label": "JPype calls"
