  "cards": [
    {
      "dot": "cyan",
      "title": "Persistent local bridge",
      "items": [
        "Node.js keeps one Python/JVM worker alive",
        "No local HTTP service between Node.js and Python"
      ]
    },
    {
      "dot": "rose",
      "title": "Native GridDB path",
      "items": [
        "Database operations do not use the GridDB Web API",
        "The Java client protects native traffic with TLS"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local AI",
      "items": [
        "Historical readings become lagged model features",
        "Forecasts are written back to GridDB Cloud"
      ]
    }
  ]
